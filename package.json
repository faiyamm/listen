{
  "name": "@actkool/listen",
  "version": "0.1.0",
  "description": "Show what you are listening to on Last.fm, with any design.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faiyamm/listen.git",
    "directory": "packages/listen"
  },
  "keywords": [
    "lastfm",
    "now-playing",
    "scrobble",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
